// Visit https://aka.ms/tsconfig to read more about this file.

/*
  Connor Borrell's tsconfig 2026
  use when colaborating... Simply chuck this file into the root directory of your project
  and make sure to have src and dist folders.
  
  To compile TS code into javascript, simply type tsc into the command line.

  Some TS basics beyond the obvoius:
  Numbers can be written with underscores separating digits.
  ex. 500000 can and should be written as 500_000.
  This is only to improve readability and will not affect performance in any way whichsoever.

  Also when programming in TS with this configuration, unused variables may not be used.
  A workaround to this is putting an underscore in front of the variable name to indicate that 
  the variable will not be used.

  You may also have a couple problems with TS recognising node modules...
  VS Code litterally tells you what to run in the command line. I'll let you figgure out how to fix this bug.

  IT IS EXTREMELY IMPORTANT THAT THIS FILE REMAINS UNCHANGED
*/

{
  "compilerOptions": {

    "removeComments": true,
    "noEmitOnError": true,

    // File Layout
    "rootDir": "./src",
    "outDir": "./public",
    
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "ESNext",
    "target": "ES2022",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    // "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
